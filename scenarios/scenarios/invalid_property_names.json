{
  "$schema": "../scenario.schema.json",
  "name": "invalid_property_names",
  "description": "Property names the registry cannot hold: one over 255 characters, one with a tab, one holding an email address — from the browser and from the server. Every SDK reports each through onError; under the recording's test key each is sent unchanged, for verify_tracking to report property_name_invalid; under a live key each is dropped and the rest of the event lands.",
  "steps": [
