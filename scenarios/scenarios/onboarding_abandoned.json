{
  "$schema": "../scenario.schema.json",
  "name": "onboarding_abandoned",
  "description": "F1, then onboarding abandoned after the first step.",
  "steps": [
    {
      "include": "acquisition"
    },
    {
      "track": "onboarding_started",
      "properties": {
        "flow_id": "initial_setup",
        "entry_point": "organic"
      },
      "at": "+1m"
    },
    {
      "track": "onboarding_step_completed",
      "properties": {
        "flow_id": "initial_setup",
        "step_id": "choose_goals",
        "step_number": 1,
        "duration_ms": 45000
      },
      "at": "+45s"
    },
    {
      "track": "onboarding_abandoned",
      "properties": {
        "flow_id": "initial_setup",
        "last_step_id": "choose_goals"
      },
      "at": "+3m"
    }
  ]
}
